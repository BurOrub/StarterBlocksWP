[
    {
        "key": "field_sv_layout",
        "name": "layout",
        "label": "Layout",
        "type": "select",
        "choices": {
            "numerato": "Elenco numerato",
            "card": "Card classiche con testo",
            "icone": "Card strette con icona",
            "passi": "Card numerate"
        },
        "default_value": "numerato",
        "return_format": "value",
        "multiple": 0
    },
    {
        "key": "field_sv_sfondo",
        "name": "sfondo",
        "label": "Sfondo (solo per le card)",
        "type": "select",
        "choices": {
            "accent": "Colore d'accento",
            "muted": "Riquadro chiaro"
        },
        "default_value": "accent",
        "return_format": "value",
        "multiple": 0,
        "conditional_logic": [
            [
                {
                    "field": "field_sv_layout",
                    "operator": "!=",
                    "value": "numerato"
                }
            ]
        ]
    },
